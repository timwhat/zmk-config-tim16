#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>

 / {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
        // -------------------------------------------------------------
        // |bluetoothL|Video PP| Mute Mic|   GRAVE |
        // |         |    F18  |    F19  |   F21   |
        // |         |    F15  |    F16  |   F17   |
        // |         |    F12  |    F13  |   F14   |

            bindings = < 
            &mo 2      &kp C_PP    &kp F24  &kp GRAVE
            &trans     &kp F19     &kp F20  &kp F21
            &mo 1      &kp F16     &kp F17  &kp F18
            &trans     &kp F13     &kp F14  &kp F15
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        functionL { // Layer 1
        // -------------------------------------------------------------
        // |         | Disccall|    Defan|  TILDE |
        // |         |    F7   |    F8   |   F9   |
        // |         |    F4   |    F5   |   F6   |
        // |         |    F1   |    F2   |   F3   |

            bindings = < 
                &trans     &kp F22     &kp F23  &kp TILDE
                &trans     &kp F7      &kp F8   &kp F9
                &trans     &kp F4      &kp F5   &kp F6
                &trans     &kp F1      &kp F2   &kp F3
            >;
            
            sensor-bindings = <&inc_dec_kp PG_UP PG_DOWN>;
        };

        extra1 {
            status = "reserved";
        };

        extra2 {
            status = "reserved";
        };

        bluetoothL {
        // -------------------------------------------------------------
        // |        |       | clear |clear all|
        // |        |zmkstudio|     |       |
        // |        |   p3  |p4     |p5     |
        // |        |   p0  |p1     |p2     |

            bindings = < 
                &trans  &studio_unlock &bt BT_CLR  &bt BT_CLR_ALL
                &trans  &trans         &trans      &trans
                &trans  &bt BT_SEL 3   &bt BT_SEL 4  &bt BT_SEL 5
                &trans  &bt BT_SEL 0   &bt BT_SEL 1  &bt BT_SEL 2
            >;    

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
